# AI Employee Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to version control

# === Vault Path ===
VAULT_PATH=./AI_Employee_Vault

# === Gmail API (for Gmail Watcher - Silver Tier) ===
# GMAIL_CLIENT_ID=your_client_id_here
# GMAIL_CLIENT_SECRET=your_client_secret_here
# GMAIL_CREDENTIALS_PATH=./credentials/gmail_token.json

# === WhatsApp (for WhatsApp Watcher - Silver Tier) ===
# WHATSAPP_SESSION_PATH=./sessions/whatsapp

# === Banking API (for Finance Watcher - Gold Tier) ===
# BANK_API_TOKEN=your_token_here

# === General ===
DRY_RUN=true
LOG_LEVEL=INFO
MAX_EMAILS_PER_HOUR=10
MAX_PAYMENTS_PER_HOUR=3
